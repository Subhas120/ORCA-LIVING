# ORCA-LIVING M4 Voice System Configuration
# Copy this file to .env and configure as needed.
# NEVER commit actual API keys or secrets.

# ---- Speech-to-Text ----
# Provider: "google_web" (default, free, internet required) or "test" (offline)
ORCA_STT_PROVIDER=google_web

# ---- Language Detection ----
# Provider: "langdetect" (default, offline) or "test" (deterministic)
ORCA_LANG_DETECTOR=langdetect

# ---- Translation ----
# Provider: "google" (default, free, internet required) or "test" (offline)
ORCA_TRANSLATION_PROVIDER=google

# ---- Text-to-Speech ----
# Provider: "gtts" (default, internet required), "pyttsx3" (offline), or "test"
ORCA_TTS_PROVIDER=gtts

# ---- Google Cloud Speech (optional production upgrade) ----
# Set this for Google Cloud Speech-to-Text instead of the free Web API
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
